{
  "name": "stl-jira-server",
  "version": "0.2.0",
  "description": "Servidor MCP do stl-jira-plugin: templates de card, validação e criação de issues no Jira com o token de cada pessoa.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test dist/test/*.test.js",
    "bundle": "node build.mjs",
    "bundle:check": "node build.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "private": true
}
